# API & Security
PROJECT_NAME="AI Workflow Automation System"
VERSION="1.0.0"
SECRET_KEY="super-secret-system-key-change-in-production-2026"
DEFAULT_API_KEY="ai-wf-key-default-admin-2026"

# Database
DATABASE_URL="sqlite:///./workflow_automation.db"

# LLM Configurations
# Set MOCK_LLM_MODE=false to use live LLMs with your API key
MOCK_LLM_MODE=true
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=

# Integrations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=automations@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ai-workflow.internal

# Workflow Engine Tuning
MAX_CONCURRENT_STEPS=5
MAX_STEP_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.5
